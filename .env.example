# Environment configuration
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Database (MongoDB)
DATABASE_URL=mongodb://localhost:27017/warehouse_vision

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# RabbitMQ
RABBITMQ_URL=amqp://warehouse_user:your_rabbitmq_password@rabbitmq:5672/
RABBITMQ_USER=warehouse_user
RABBITMQ_PASSWORD=your_rabbitmq_password

# ELK Stack
ELASTIC_PASSWORD=your_elastic_password

# Model Registry
MODEL_REGISTRY=/app/models

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Performance
WORKERS_PER_CORE=1
MAX_WORKERS=4
WORKER_TIMEOUT=120

# NOTE: Remember to replace all "your_*_password" placeholders with strong, unique passwords
# in your actual .env file. Never commit the actual .env file to version control.
